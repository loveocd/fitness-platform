PORT=3000

# MySQL 连接配置（Sequelize 会自动创建数据库和数据表）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=fitness_platform

# 首次启动且 users 表为空时自动写入演示数据
AUTO_SEED=true
# 开发阶段需要同步字段变更时可临时开启
DB_SYNC_ALTER=false

JWT_SECRET=fitness_platform_secret_2026
JWT_EXPIRES_IN=7d

# 前端地址（跨域）
CLIENT_ORIGIN=http://localhost:5173
